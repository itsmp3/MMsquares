{
  "name": "mmsquares",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply mmsquares --local",
    "db:migrate:remote": "wrangler d1 migrations apply mmsquares --remote",
    "db:seed-history:local": "wrangler d1 execute mmsquares --local --file seed/history.sql",
    "db:seed-history:remote": "wrangler d1 execute mmsquares --remote --file seed/history.sql",
    "deploy": "vite build && node scripts/inline-assets.mjs && wrangler deploy -c wrangler.deploy.jsonc",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.13.18",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
